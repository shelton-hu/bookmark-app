# Only project entry points and source directories belong at the repository root.
# Add a new root-level source/configuration file explicitly when it is needed.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/API-CONTRACT.md
!/THIRD_PARTY_ASSETS.md
!/LICENSE
!/LICENSE.*
!/Dockerfile
!/Makefile
!/requirements.txt
!/buildkitd.toml
!/compose.yaml
!/compose.deploy.yaml
!/.github/
!/docs/
!/backend/
!/extension/
!/tools/
!/web/

# Runtime data, dependencies, caches, credentials and diagnostic captures.
.venv/
node_modules/
data/
.test-data/
__pycache__/
*.pyc
*.tsbuildinfo
.pytest_cache/
.DS_Store
.env
.env.*
!/.env.example
!/.env.deploy.example
.envrc
.netrc
.npmrc
.ssh/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.pem
*.key
*.p12
*.pfx
*.log
*.har
*.bak
*.backup
*.tar.gz
*.zip

# Only the production frontend and its tests/configuration are shared.
/web/*
!/web/index.html
!/web/package.json
!/web/package-lock.json
!/web/tsconfig.json
!/web/vite.config.ts
!/web/src/
!/web/tests/
!/web/public/
# This test belongs to the local archived summoning experiment.
/web/tests/card-summoning.test.mjs

# Keep the active brand, original deck and scene assets; ignore design proofs.
/web/public/*
!/web/public/favicon.svg
!/web/public/brand/
!/web/public/clow-deck/
!/web/public/clow-scene/
/web/public/brand/*
!/web/public/brand/sealed-book.svg
!/web/public/brand/sealed-book-transparent.svg
/web/public/clow-deck/*
!/web/public/clow-deck/*.webp
!/web/public/clow-deck/manifest.json
/web/public/clow-scene/*
!/web/public/clow-scene/clow-circle.svg
!/web/public/clow-scene/sealing-wand.svg
!/web/public/clow-scene/provenance.json

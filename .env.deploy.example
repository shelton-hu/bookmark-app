# Replace this placeholder with your published image repository.
BOOKMARK_IMAGE=ghcr.io/your-github-username/bookmark-app
# Published image tag to deploy.
BOOKMARK_TAG=v0.0.1
# Anonymous GitHub version checks; set false for an offline deployment.
BOOKMARK_CHECK_UPDATES=true
# Bind to all LAN interfaces. Do not expose this port directly to the Internet.
BOOKMARK_BIND=0.0.0.0
BOOKMARK_PORT=8093
# Leave empty for direct access such as http://nas.local:8093.
# For a reverse proxy, use its exact external origin without a path; separate multiple origins with commas.
BOOKMARK_ALLOWED_ORIGINS=
# Replace this with an absolute directory on the Docker host.
BOOKMARK_DATA_DIR=/volume1/docker/bookmark-app/data

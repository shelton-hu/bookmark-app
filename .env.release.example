# Copy to .env.release, then replace both registry placeholders.
# This file contains no login credentials; use make login for authentication.
REGISTRY=registry.example.com
IMAGE=registry.example.com/your-namespace/bookmark-app
PLATFORMS=linux/amd64,linux/arm64
# Optional: publish stable version tags to this public GitHub remote after image verification.
# This shares the committed release source with that remote and enables in-app update checks.
RELEASE_GIT_REMOTE=origin
# BUMP=patch
